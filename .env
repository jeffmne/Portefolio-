# Variables publiques du site — CE FICHIER EST VERSIONNÉ.
#
# N'y placer que des valeurs destinées à être publiques. Tout secret réel
# (mot de passe, clé privée, token) va dans .env.local, ignoré par git, ou
# dans Vercel : Settings > Environment Variables.

# Clé d'accès Web3Forms du formulaire de contact.
# Le préfixe NEXT_PUBLIC_ signifie que Next.js l'intègre au bundle envoyé au
# navigateur : cette clé est de toute façon visible par n'importe quel
# visiteur du site. La protection ne vient donc pas du secret, mais de la
# restriction de domaine à configurer sur https://web3forms.com.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=23f9ae80-7298-4073-989b-1ce1d8df8337
